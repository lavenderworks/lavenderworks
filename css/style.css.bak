/* Reset */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial, sans-serif;
}

/* Navigation */
nav {
  background-color: #2c3e50;
  padding: 1em;
}
nav ul {
  list-style: none;
  display: flex;
  gap: 2em;
}
nav a {
  text-decoration: none;
  color: white;
  font-weight: bold;
}
nav a.active {
  color: #f39c12;
}

/* Footer */
footer {
  background-color: #2c3e50;
  color: white;
  text-align: center;
  padding: 1em;
  position: relative;
  bottom: 0;
  width: 100%;
}

/* Allgemeines Layout */
body {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

main {
  flex: 1;
  padding: 2em;
}
/* Services Seite */
.services-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 2em;
  margin-top: 2em;
}

.service-card {
  background-color: #ecf0f1;
  padding: 1.5em;
  border-radius: 10px;
  box-shadow: 0 4px 8px rgba(0,0,0,0.1);
  transition: transform 0.2s, box-shadow 0.2s;
}

.service-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 16px rgba(0,0,0,0.2);
}

.service-card h2 {
  margin-bottom: 0.5em;
  color: #2c3e50;
}

.service-card p {
  color: #34495e;
  line-height: 1.4;
}
/* Kontaktformular */
.contact-form-container {
  max-width: 600px;
  margin: 2em auto;
  background-color: #ecf0f1;
  padding: 2em;
  border-radius: 10px;
  box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}

.contact-form-container label {
  display: block;
  margin-top: 1em;
  font-weight: bold;
  color: #2c3e50;
}

.contact-form-container input,
.contact-form-container textarea {
  width: 100%;
  padding: 0.75em;
  margin-top: 0.5em;
  border: 1px solid #bdc3c7;
  border-radius: 5px;
  font-size: 1em;
}

.contact-form-container button {
  margin-top: 1.5em;
  padding: 0.75em 1.5em;
  background-color: #2c3e50;
  color: white;
  border: none;
  border-radius: 5px;
  cursor: pointer;
  font-size: 1em;
  transition: background-color 0.2s;
}

.contact-form-container button:hover {
  background-color: #34495e;
}

#formMessage {
  margin-top: 1em;
  font-weight: bold;
  color: #27ae60; /* Grün für Erfolg */
}
/* Über mich Seite */
.about-container {
  display: flex;
  flex-wrap: wrap;
  gap: 2em;
  align-items: center;
  margin-top: 2em;
}

.about-image {
  flex: 1 1 200px;
  text-align: center;
}

.about-image img {
  max-width: 200px;
  width: 100%;
  border-radius: 50%;
  box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}

.about-text {
  flex: 2 1 300px;
}

.about-text h2 {
  margin-bottom: 0.5em;
  color: #2c3e50;
}

.about-text p {
  margin-bottom: 1em;
  line-height: 1.5;
  color: #34495e;
}

.about-skills {
  margin-top: 2em;
}

.about-skills ul {
  list-style-type: disc;
  padding-left: 1.5em;
}

.about-skills li {
  margin-bottom: 0.5em;
  color: #2c3e50;
}
