<!DOCTYPE html>
<html lang="de">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    LavenderWorks Angebotsgenerator
  </title>

  <link
    rel="stylesheet"
    href="../css/style.css"
  >

  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

  <style>

    * {

      box-sizing: border-box;
    }

    body {

      font-family: Arial, sans-serif;

      background: #f4f4f4;

      margin: 0;

      padding: 0;

      color: #111;
    }

    /* =========================
       LAYOUT
    ========================= */

    .offer-page {

      width: 100%;

      padding: 20px 10px;

      display: flex;

      justify-content: center;
    }

    #pdfDocument {

      width: 100%;

      display: flex;

      flex-direction: column;

      align-items: center;

      gap: 24px;
    }

    /* =========================
       A4 PAGE
    ========================= */

    .offer-preview {

      width: 210mm;

      min-height: 297mm;

      background: white;

      position: relative;

      overflow: hidden;

      padding: 16mm;

      border-radius: 14px;

      box-shadow:
        0 10px 35px rgba(0,0,0,0.08);
    }

    .pdf-page-2 {

      page-break-before: always;
    }

    /* =========================
       HEADER
    ========================= */

    .pdf-header {

      display: flex;

      justify-content: space-between;

      align-items: flex-start;

      gap: 20px;

      margin-bottom: 10mm;

      padding-bottom: 5mm;

      border-bottom: 0.4mm solid #ececec;
    }

    .brand {

      display: flex;

      align-items: center;

      gap: 5mm;
    }

    .logo {

      width: 28mm;

      object-fit: contain;
    }

    .brand h1 {

      margin: 0;

      font-size: 18pt;

      line-height: 1.1;
    }

    .brand p {

      margin: 1mm 0 0;

      font-size: 10pt;

      color: #666;
    }

    .meta {

      text-align: right;

      font-size: 9pt;

      color: #555;

      line-height: 1.5;
    }

    /* =========================
       CONTENT
    ========================= */

    .preview-section {

      margin-bottom: 8mm;
    }

    .preview-section h2 {

      margin: 0 0 3mm;

      padding-bottom: 1.5mm;

      border-bottom: 0.3mm solid #ececec;

      font-size: 10pt;

      text-transform: uppercase;

      letter-spacing: 0.7px;

      color: #222;
    }

    .preview-section p,
    .preview-section pre {

      margin: 0;

      font-size: 10.5pt;

      line-height: 1.55;

      white-space: pre-wrap;

      word-break: break-word;
    }

    /* =========================
       PRICE BOX
    ========================= */

    .preview-total {

      margin-top: 10mm;

      padding: 6mm;

      border: 0.4mm solid #ddd;

      border-radius: 10px;

      background: #fafafa;

      font-size: 13pt;
    }

    .preview-total strong {

      font-size: 15pt;
    }

    /* =========================
       FOOTER
    ========================= */

    .pdf-footer {

      position: absolute;

      left: 16mm;

      right: 16mm;

      bottom: 14mm;

      font-size: 7.6pt;

      line-height: 1.45;

      color: #666;
    }

    .footer-line {

      width: 100%;

      border-top: 0.3mm solid #ddd;

      margin-bottom: 3mm;
    }

    /* =========================
       LEGAL PAGE
    ========================= */

    .legal-intro {

      font-size: 7.8pt;

      color: #666;

      line-height: 1.5;

      margin-bottom: 6mm;
    }

    .legal-container {

      display: flex;

      flex-direction: column;

      gap: 2mm;

      font-size: 8.2pt;

      line-height: 1.5;

      color: #444;
    }

    .legal-container h1 {

      margin: 0 0 3mm;

      padding-bottom: 2mm;

      border-bottom: 0.3mm solid #ddd;

      font-size: 12pt;

      text-transform: uppercase;

      letter-spacing: 1px;
    }

    .legal-container h2 {

      margin: 3mm 0 1mm;

      font-size: 8.7pt;

      text-transform: uppercase;

      letter-spacing: 0.5px;

      color: #222;
    }

    .legal-container p {

      margin: 0;
    }

    .legal-container hr {

      width: 100%;

      border: none;

      border-top: 0.2mm solid #e8e8e8;

      margin: 2mm 0;
    }

    .legal-small {

      margin-top: 7mm !important;

      font-size: 7.2pt !important;

      color: #777;
    }

    /* =========================
       BUTTON
    ========================= */

    .button-container {

      width: 100%;

      max-width: 210mm;

      margin: 0 auto 30px;

      padding: 0 10px;
    }

    button {

      width: 100%;

      border: none;

      border-radius: 14px;

      padding: 14px;

      cursor: pointer;

      background:
        linear-gradient(
          135deg,
          #111,
          #2d2d2d
        );

      color: white;

      font-size: 15px;

      font-weight: 600;

      transition: 0.2s ease;

      box-shadow:
        0 6px 18px rgba(0,0,0,0.14);
    }

    button:hover {

      transform: translateY(-1px);
    }

    /* =========================
       MOBILE
    ========================= */

    @media (max-width: 768px) {

      .offer-page {

        padding: 10px 0;
      }

      .offer-preview {

        width: 100%;

        min-height: auto;

        border-radius: 0;

        padding: 10mm;

        box-shadow: none;
      }

      .pdf-header {

        flex-direction: column;

        gap: 5mm;
      }

      .meta {

        text-align: left;
      }

      .button-container {

        padding: 10px;
      }
    }

    /* =========================
       PRINT / PDF
    ========================= */

    @media print {

      body {

        background: white;
      }

      .offer-preview {

        box-shadow: none;

        border-radius: 0;
      }

      .button-container {

        display: none;
      }
    }

  </style>

</head>

<body>

  <main class="offer-page">

    <div id="pdfDocument">

      <!-- =========================
           PAGE 1
      ========================= -->

      <div
        class="offer-preview"
        id="offerPreview"
      >

        <!-- HEADER -->

        <div class="pdf-header">

          <div class="brand">

            <img
              src="/assets/logo.png"
              class="logo"
            >

            <div>

              <h1>
                LavenderWorks
              </h1>

              <p>
                Moderne digitale Lösungen
              </p>

            </div>

          </div>

          <div class="meta">

            <p>
              <strong>
                Angebot:
              </strong>

              <span id="previewNumber"></span>
            </p>

            <p>
              <strong>
                Datum:
              </strong>

              <span id="previewDate"></span>
            </p>

          </div>

        </div>

        <!-- KUNDE -->

        <div class="preview-section">

          <h2>
            Kunde
          </h2>

          <p id="previewCustomer">
            —
          </p>

          <p id="previewEmail">
            —
          </p>

        </div>

        <!-- PROJEKT -->

        <div class="preview-section">

          <h2>
            Projekt
          </h2>

          <p id="previewProject">
            —
          </p>

        </div>

        <!-- LEISTUNGEN -->

        <div class="preview-section">

          <h2>
            Leistungen
          </h2>

          <pre id="previewServices">—</pre>

        </div>

        <!-- BESCHREIBUNG -->

        <div class="preview-section">

          <h2>
            Projektbeschreibung
          </h2>

          <p id="previewExtra">
            —
          </p>

        </div>

        <!-- PREIS -->

        <div class="preview-total">

          Gesamtpreis:
          <strong id="previewPrice">
            0€
          </strong>

        </div>

        <!-- FOOTER -->

        <div class="pdf-footer">

          <div class="footer-line"></div>

          <p>
            LavenderWorks · Digitale Dienstleistungen · Deutschland
          </p>

          <p>
            Dieses Angebot ist freibleibend und unverbindlich.
            Änderungen und Irrtümer vorbehalten.
          </p>

        </div>

      </div>

      <!-- =========================
           PAGE 2
      ========================= -->

      <div class="offer-preview pdf-page-2">

        <section class="legal-container">

          <p class="legal-intro">

            Die folgenden Hinweise und Bedingungen sind Bestandteil
            dieses Angebots, sofern nicht ausdrücklich schriftlich
            etwas anderes vereinbart wurde.

          </p>

          <h1>
            Rechtliche Hinweise
          </h1>

          <h2>
            Anbieter
          </h2>

          <p>
            LavenderWorks · Digitale Dienstleistungen
          </p>

          <p>
            Deutschland
          </p>

          <p>
            Kontakt:
            joana.o.lavender@gmail.com
          </p>

          <hr>

          <h2>
            Angebot & Leistungen
          </h2>

          <p>
            Dieses Angebot ist freibleibend und unverbindlich.
            Der genaue Leistungsumfang ergibt sich aus der
            individuellen Projektabsprache.
          </p>

          <p>
            Änderungen, Erweiterungen oder zusätzliche Anforderungen
            können den finalen Preis beeinflussen.
          </p>

          <hr>

          <h2>
            Zahlung
          </h2>

          <p>
            Zahlungen erfolgen nach individueller Vereinbarung.
            Bei größeren Projekten kann eine Teil-
            oder Vorauszahlung vereinbart werden.
          </p>

          <hr>

          <h2>
            Mitwirkungspflicht
          </h2>

          <p>
            Der Kunde stellt alle notwendigen Inhalte,
            Informationen und Materialien rechtzeitig zur Verfügung.
          </p>

          <hr>

          <h2>
            Nutzungsrechte
          </h2>

          <p>
            Nutzungsrechte an erstellten Leistungen gehen grundsätzlich
            erst nach vollständiger Bezahlung über.
          </p>

          <hr>

          <h2>
            Haftung
          </h2>

          <p>
            LavenderWorks haftet nur im Rahmen der gesetzlichen Vorschriften.
            Für Inhalte Dritter, externe Dienste, Hosting-Anbieter oder
            Datenverluste wird keine Haftung übernommen,
            soweit gesetzlich zulässig.
          </p>

          <hr>

          <h2>
            Datenschutz
          </h2>

          <p>
            Personenbezogene Daten werden ausschließlich zur Bearbeitung
            von Anfragen, Kommunikation und Projektabwicklung verarbeitet.
          </p>

          <p>
            Weitere Informationen:
            lavenderworks.de/datenschutz/
          </p>

          <hr>

          <h2>
            Allgemeine Geschäftsbedingungen
          </h2>

          <p>
            Es gelten die Allgemeinen Geschäftsbedingungen
            von LavenderWorks.
          </p>

          <p>
            Vollständige AGB:
            lavenderworks.de/agb/
          </p>

          <hr>

          <p class="legal-small">

            Stand: Mai 2026 · Änderungen und Irrtümer vorbehalten.

          </p>

        </section>

      </div>

    </div>

  </main>

  <!-- BUTTON -->

  <div class="button-container">

    <button onclick="generatePDF()">

      📄 PDF herunterladen

    </button>

  </div>

  <script>

    /* =========================
       LOAD DATA
    ========================= */

    const data =
      JSON.parse(
        sessionStorage.getItem(
          "lw_offer_data"
        ) || "{}"
      );

    /* =========================
       OFFER NUMBER
    ========================= */

    const offerNumber =

      data.offerNumber ||

      `LW-2026-${
        Math.floor(
          1000 + Math.random() * 9000
        )
      }`;

    /* =========================
       DATE
    ========================= */

    const currentDate =
      new Date().toLocaleDateString("de-DE");

    /* =========================
       INSERT DATA
    ========================= */

    document.getElementById(
      "previewNumber"
    ).textContent =
      offerNumber;

    document.getElementById(
      "previewDate"
    ).textContent =
      currentDate;

    document.getElementById(
      "previewCustomer"
    ).textContent =
      data.customerName || "—";

    document.getElementById(
      "previewEmail"
    ).textContent =
      data.customerEmail || "—";

    document.getElementById(
      "previewProject"
    ).textContent =
      data.projectTitle || "—";

    document.getElementById(
      "previewServices"
    ).textContent =
      (data.summary || []).join("\n") || "—";

    document.getElementById(
      "previewExtra"
    ).textContent =
      data.description || "—";

    document.getElementById(
      "previewPrice"
    ).textContent =
      data.totalPrice || "0€";

    /* =========================
       PDF EXPORT
    ========================= */

    function generatePDF() {

      const element =
        document.getElementById(
          "pdfDocument"
        );

      const opt = {

        margin: 0,

        filename:
          `${offerNumber}.pdf`,

        image: {

          type: "jpeg",

          quality: 1
        },

        html2canvas: {

          scale: 2,

          useCORS: true,

          backgroundColor: "#ffffff",

          scrollY: 0
        },

        jsPDF: {

          unit: "mm",

          format: "a4",

          orientation: "portrait"
        },

        pagebreak: {

          mode: [
            "css",
            "legacy"
          ]
        }
      };

      html2pdf()
        .set(opt)
        .from(element)
        .save();
    }

  </script>

</body>

</html>
