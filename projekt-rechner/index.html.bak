<!DOCTYPE html>
<html lang="de">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    LavenderWorks — Projekt Konfigurator
  </title>

  <meta
    name="description"
    content="Stelle dein individuelles Projekt zusammen und erhalte direkt eine ungefähre Preisübersicht."
  >

  <link
    rel="stylesheet"
    href="../css/style.css"
  >

</head>

<body>

  <header></header>

  <main class="lw-calculator-page">

    <!-- HERO -->

    <section class="lw-calculator-hero">

      <div class="lw-calculator-hero-content">

        <span class="lw-tag">
          LavenderWorks
        </span>

        <h1>
          Projekt konfigurieren
        </h1>

        <p>
          Stelle dir deine Website,
          kreative Unterstützung,
          Automatisierungen oder technische Hilfe
          individuell zusammen.
        </p>

      </div>

    </section>

    <!-- CALCULATOR -->

    <section class="lw-calculator-section">

      <div class="lw-calculator-layout">

        <!-- LEFT -->

        <div class="lw-calculator-form">

          <!-- PROJECT TYPE -->

          <div class="lw-card">

            <h2>
              Projektart
            </h2>

            <div class="lw-grid">

              <label class="lw-option">

                <input
                  type="radio"
                  name="projectType"
                  value="website"
                  checked
                >

                <span>
                  💻 Website
                </span>

              </label>

              <label class="lw-option">

                <input
                  type="radio"
                  name="projectType"
                  value="writing"
                >

                <span>
                  ✍️ Texte
                </span>

              </label>

              <label class="lw-option">

                <input
                  type="radio"
                  name="projectType"
                  value="automation"
                >

                <span>
                  ⚡ Automatisierung
                </span>

              </label>

              <label class="lw-option">

                <input
                  type="radio"
                  name="projectType"
                  value="support"
                >

                <span>
                  🛠️ Techsupport
                </span>

              </label>

            </div>

          </div>

          <!-- WEBSITE -->

          <details
            class="lw-card"
            open
            id="websiteSection"
          >

            <summary>
              💻 Webseiten & Landing Pages
            </summary>

            <div class="lw-content">

              <div class="lw-field">

                <label>
                  Website Typ
                </label>

                <select id="websiteType">

                  <option value="0">
                  </option>

                  <option value="49">
                    One Page Website — 49€
                  </option>

                  <option value="60">
                    Portfolio Website — 60€
                  </option>

                  <option value="79">
                    Business Website — 79€
                  </option>

                  <option value="90">
                    Individuelle Landing Page — 90€
                  </option>

                </select>

              </div>

              <div class="lw-field">

                <label>
                  Zusätzliche Seiten
                </label>

                <input
                  type="number"
                  id="extraPages"
                  min="0"
                  value="0"
                >

              </div>

              <div class="lw-checkboxes">

                <label>
                  <input
                    type="checkbox"
                    class="calc-extra"
                    data-name="GitHub Subdomain"
                    value="10"
                  >
                  GitHub Subdomain (+10€)
                </label>

                <label>
                  <input
                    type="checkbox"
                    class="calc-extra"
                    data-name="Wunschdomain Einrichtung"
                    value="20"
                  >
                  Wunschdomain (+20€)
                </label>

                <label>
                  <input
                    type="checkbox"
                    class="calc-extra"
                    data-name="Kontaktformular"
                    value="7"
                  >
                  Kontaktformular (+7€)
                </label>

                <label>
                  <input
                    type="checkbox"
                    class="calc-extra"
                    data-name="WhatsApp Kontakt"
                    value="5"
                  >
                  WhatsApp Integration (+5€)
                </label>

                <label>
                  <input
                    type="checkbox"
                    class="calc-extra"
                    data-name="Animationen"
                    value="7"
                  >
                  Animationen (+7€)
                </label>

                <label>
                  <input
                    type="checkbox"
                    class="calc-extra"
                    data-name="Interaktive Elemente"
                    value="15"
                  >
                  Interaktive Elemente (+15€)
                </label>

                <label>
                  <input
                    type="checkbox"
                    class="calc-extra"
                    data-name="FAQ Bereich"
                    value="5"
                  >
                  FAQ Sektion (+5€)
                </label>

                <label>
                  <input
                    type="checkbox"
                    class="calc-extra"
                    data-name="Impressum & Datenschutz"
                    value="8"
                  >
                  Impressum & Datenschutz (+8€)
                </label>

              </div>

            </div>

          </details>

          <!-- TEXTS -->

          <details
            class="lw-card"
            id="textSection"
          >

            <summary>
              ✍️ Texte & Inhalte
            </summary>

            <div class="lw-content">

              <div class="lw-field">

                <label>
                  Textservice
                </label>

                <select id="textType">

                  <option value="0">
                    Texte vorhanden
                  </option>

                  <option value="5">
                    Texte schreiben (+5€)
                  </option>

                  <option value="3">
                    Texte überarbeiten (+3€)
                  </option>

                </select>

              </div>

              <div class="lw-field">

                <label>
                  Anzahl Texte
                </label>

                <input
                  type="number"
                  id="textCount"
                  min="0"
                  value="0"
                >

              </div>

              <div class="lw-checkboxes">

                <label>
                  <input
                    type="checkbox"
                    class="calc-extra"
                    data-name="SEO Optimierung"
                    value="10"
                  >
                  SEO Optimierung (+10€)
                </label>

                <label>
                  <input
                    type="checkbox"
                    class="calc-extra"
                    data-name="Produktbeschreibungen"
                    value="8"
                  >
                  Produkttexte (+8€)
                </label>

                <label>
                  <input
                    type="checkbox"
                    class="calc-extra"
                    data-name="Kreative Texte"
                    value="12"
                  >
                  Kreative Texte (+12€)
                </label>

              </div>

            </div>

          </details>

          <!-- DESIGN -->

          <details
            class="lw-card"
            id="designSection"
          >

            <summary>
              🎨 Design & Branding
            </summary>

            <div class="lw-content">

              <div class="lw-checkboxes">

                <label>
                  <input
                    type="checkbox"
                    class="calc-extra"
                    data-name="Logo Design"
                    value="15"
                  >
                  Logo Design (+15€)
                </label>

                <label>
                  <input
                    type="checkbox"
                    class="calc-extra"
                    data-name="Hero Image"
                    value="10"
                  >
                  Hero Image (+10€)
                </label>

                <label>
                  <input
                    type="checkbox"
                    class="calc-extra"
                    data-name="UI Verbesserung"
                    value="20"
                  >
                  UI/UX Verbesserung (+20€)
                </label>

                <label>
                  <input
                    type="checkbox"
                    class="calc-extra"
                    data-name="Portfolio Design"
                    value="25"
                  >
                  Portfolio Design (+25€)
                </label>

              </div>

            </div>

          </details>

          <!-- AUTOMATION -->

          <details
            class="lw-card"
            id="automationSection"
          >

            <summary>
              ⚡ Automatisierungen & Tools
            </summary>

            <div class="lw-content">

              <div class="lw-checkboxes">

                <label>
                  <input
                    type="checkbox"
                    class="calc-extra"
                    data-name="Mini Webtool"
                    value="20"
                  >
                  Mini Webtool (+20€)
                </label>

                <label>
                  <input
                    type="checkbox"
                    class="calc-extra"
                    data-name="Task Automation"
                    value="25"
                  >
                  Task Automation (+25€)
                </label>

                <label>
                  <input
                    type="checkbox"
                    class="calc-extra"
                    data-name="Kleines Script"
                    value="15"
                  >
                  Kleines Script (+15€)
                </label>

              </div>

            </div>

          </details>

          <!-- SUPPORT -->

          <details
            class="lw-card"
            id="supportSection"
          >

            <summary>
              🛠️ Techsupport & Beratung
            </summary>

            <div class="lw-content">

              <div class="lw-field">

                <label>
                  Stunden
                </label>

                <input
                  type="number"
                  id="supportHours"
                  min="0"
                  value="0"
                >

              </div>

              <div class="lw-checkboxes">

                <label>
                  <input
                    type="checkbox"
                    class="calc-extra"
                    data-name="GitHub Hilfe"
                    value="15"
                  >
                  GitHub Hilfe (+15€)
                </label>

                <label>
                  <input
                    type="checkbox"
                    class="calc-extra"
                    data-name="Termux Hilfe"
                    value="15"
                  >
                  Termux Hilfe (+15€)
                </label>

                <label>
                  <input
                    type="checkbox"
                    class="calc-extra"
                    data-name="Einrichtung & Konfiguration"
                    value="20"
                  >
                  Einrichtung & Konfiguration (+20€)
                </label>

              </div>

            </div>

          </details>

          <!-- DESCRIPTION -->

          <div class="lw-card">

            <h2>
              Projektbeschreibung
            </h2>

            <textarea
              id="projectDescription"
              rows="7"
              placeholder="Beschreibe möglichst genau dein Projekt..."
            ></textarea>

          </div>

        </div>

        <!-- RIGHT -->

        <aside class="lw-summary">

          <div class="lw-summary-box">

            <span class="lw-tag">
              Preisübersicht
            </span>

            <h2>
              Geschätzter Preis
            </h2>

            <div
              class="lw-price"
              id="totalPrice"
            >
              0€
            </div>

            <ul
              class="lw-summary-list"
              id="summaryList"
            ></ul>
<button class="lw-button" onclick="openPDFPreview()">
  PDF Vorschau
</button>
            <a
              id="whatsappButton"
              class="lw-button"
              target="_blank"
            >
              Projekt anfragen
            </a>

          </div>

        </aside>

      </div>

    </section>

  </main>

  <footer></footer>

  <script src="../js/main.js"></script>

  <script>

    function calculatePrice() {

      let total = 0;

      let summary = [];

      // WEBSITE

      const websitePrice =
        parseFloat(
          document.getElementById(
            "websiteType"
          ).value
        );

      total += websitePrice;

      summary.push(
        document.getElementById(
          "websiteType"
        ).selectedOptions[0].text
      );

      // EXTRA PAGES

      const extraPages =
        parseInt(
          document.getElementById(
            "extraPages"
          ).value
        ) || 0;

      if(extraPages > 0) {

        const extraPagePrice =
          extraPages * 15;

        total += extraPagePrice;

        summary.push(
          `${extraPages} zusätzliche Seiten (+${extraPagePrice}€)`
        );
      }

      // TEXTS

      const textType =
        parseFloat(
          document.getElementById(
            "textType"
          ).value
        );

      const textCount =
        parseInt(
          document.getElementById(
            "textCount"
          ).value
        ) || 0;

      if(textType > 0) {

        const textPrice =
          textType +
          (textCount * 1.5);

        total += textPrice;

        summary.push(
          `Texte (${textCount}) (+${textPrice.toFixed(2)}€)`
        );
      }

      // SUPPORT

      const supportHours =
        parseInt(
          document.getElementById(
            "supportHours"
          ).value
        ) || 0;

      if(supportHours > 0) {

        const supportPrice =
          supportHours * 10;

        total += supportPrice;

        summary.push(
          `Techsupport (${supportHours}h) (+${supportPrice}€)`
        );
      }

      // EXTRAS

      document
        .querySelectorAll(".calc-extra")
        .forEach(extra => {

          if(extra.checked) {

            total +=
              parseFloat(extra.value);

            summary.push(
              `${extra.dataset.name} (+${extra.value}€)`
            );
          }
        });

      // OUTPUT

      document.getElementById(
        "totalPrice"
      ).textContent =
        total.toFixed(2) + "€";

      const summaryList =
        document.getElementById(
          "summaryList"
        );

      summaryList.innerHTML = "";

      summary.forEach(item => {

        summaryList.innerHTML += `
          <li>${item}</li>
        `;
      });

      // WHATSAPP

      const description =
        document.getElementById(
          "projectDescription"
        ).value;

      const message =

`Hallo LavenderWorks 👋

Ich interessiere mich für folgendes Projekt:

${summary.join("\n")}

Projektbeschreibung:
${description || "Keine Beschreibung"}

Geschätzter Preis:
${total.toFixed(2)}€
`;

      document.getElementById(
        "whatsappButton"
      ).href =

        "https://wa.me/4915215448631?text=" +
        encodeURIComponent(message);
    }

    // EVENTS

    document.addEventListener(
      "input",
      calculatePrice
    );

function openPDFPreview() {

  // SUMMARY LIST aus DOM holen
  const summaryItems = [];

  document.querySelectorAll("#summaryList li").forEach(li => {
    summaryItems.push(li.textContent);
  });

  const data = {
    websiteType: document.getElementById("websiteType").value,
    websiteText: document.getElementById("websiteType").selectedOptions[0].text,

    extraPages: document.getElementById("extraPages").value,

    textType: document.getElementById("textType").value,
    textCount: document.getElementById("textCount").value,

    supportHours: document.getElementById("supportHours").value,

    description: document.getElementById("projectDescription").value,

    totalPrice: document.getElementById("totalPrice").textContent,

    summary: summaryItems
  };

  sessionStorage.setItem("lw_offer_data", JSON.stringify(data));

  window.open("/pdf-export/", "_blank");
}
    calculatePrice();

  </script>

</body>

</html>
